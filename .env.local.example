# Supabase — get these from your Supabase project settings > API
# For local dev: run `supabase start` and copy the values from the output
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Verification gate — only this domain can sign up
ALLOWED_EMAIL_DOMAIN=usa.edu.ph

# Web Push VAPID keys (Phase 4)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Supabase — get these from your Supabase project settings > API
# For local dev: run `supabase start` and copy the values from the output
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Verification gate — only this domain can sign up
ALLOWED_EMAIL_DOMAIN=usa.edu.ph

# Web Push VAPID keys (Phase 4)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Playwright E2E only — put this in .env.test.local (gitignored), never
# .env.local. Used by e2e/helpers/auth.ts to mint a session for the fixture
# user (supabase/seed.sql) without a real OTP round trip. Never ship this
# key to the client; it's read only in test setup code.
# SUPABASE_SERVICE_ROLE_KEY=
